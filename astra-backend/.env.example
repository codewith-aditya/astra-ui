# ═══════════════════════════════════════════════════════════════════════════
#  AstraGPT backend configuration
#
#  Copy to .env and fill in. config/env.js validates this file at startup and
#  REFUSES TO BOOT on a missing or weak required value, rather than falling back
#  to a committed default.
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ─── Required ───────────────────────────────────────────────────────────────

# MongoDB connection string.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/astragpt

# Signs access + refresh tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 48
# The previously committed value is explicitly rejected by the validator.
JWT_SECRET=

# Guards every admin endpoint. Minimum 16 characters.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Exact browser origins allowed to call the API, comma-separated.
# Required in production — there is no permissive fallback.
ALLOWED_ORIGINS=https://astragpt.in,https://www.astragpt.in

# ─── Tokens ─────────────────────────────────────────────────────────────────

ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=astragpt

# ─── Proxy ──────────────────────────────────────────────────────────────────

# Number of proxy hops in front of the app. 1 = nginx only. Wrong values here
# make the client IP (and therefore per-IP rate limiting) unreliable.
TRUST_PROXY=1
BEHIND_CLOUDFLARE=0

# Absolute base URL used to build public asset URLs. Leave blank to emit
# relative URLs, which is correct when the frontend shares the origin.
PUBLIC_BASE_URL=

# ─── Email / OTP delivery ───────────────────────────────────────────────────
# Without these, OTP email cannot be sent and signup/login will fail.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AstraGPT <no-reply@astragpt.in>
# Only set to false against a server with a self-signed certificate.
SMTP_REJECT_UNAUTHORIZED=true

# ─── Rate limiting ──────────────────────────────────────────────────────────
# Optional but strongly recommended: without Redis, limits are per-process and
# reset on restart, so a multi-instance deployment enforces them inconsistently.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Model providers ────────────────────────────────────────────────────────
# No key is hardcoded in source. A missing key disables that provider instead of
# silently using a committed literal.

AISUBSCRIPTION_API_URL=https://api.aisubscription.shop/v1/chat/completions
AISUBSCRIPTION_API_KEY=

NEXUSIFY_API_URL=https://api.nexusify.co/v1/responses
NEXUSIFY_API_KEY=

# Used only for audio transcription (Whisper) and text-to-speech.
OPENAI_API_KEY=

# ─── Supabase (optional) ────────────────────────────────────────────────────
# Used only to verify identity for Supabase-issued tokens. Plan always comes
# from MongoDB. If unset, Supabase token verification is disabled and fails
# closed — it never falls back to trusting a raw bearer value.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Code execution sandbox ─────────────────────────────────────────────────
# Requires Docker on the host. Execution runs in a throwaway container with no
# network, a read-only root filesystem, dropped capabilities and a non-root user.

ENABLE_SANDBOX=1
SANDBOX_IMG_PY=python:3.12-slim
SANDBOX_IMG_NODE=node:20-alpine
SANDBOX_IMG_SH=alpine:3.20
SANDBOX_MAX_CONCURRENT=4
# Pre-pull images at boot so the first request does not pay the pull cost.
SANDBOX_WARM_IMAGES=0

# ─── Agentic tool calling ───────────────────────────────────────────────────
# Off by default. Note that systemPrompt.txt advertises web search and URL
# analysis; with this unset the model has no tool to perform them and may
# fabricate results. Either enable this or trim those prompt sections.
ENABLE_TOOLS=0

# ─── Limits ─────────────────────────────────────────────────────────────────
# Keep nginx's client_max_body_size at or above these values, otherwise nginx
# rejects the upload with a 413 before it ever reaches Node.

MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_BYTES=10485760
JSON_BODY_LIMIT=20mb
SHUTDOWN_TIMEOUT_MS=15000

# ─── Optional integrations ──────────────────────────────────────────────────

DISCORD_CONTACT_WEBHOOK=
# JSON array: [{"id":"main","name":"Main","url":"http://127.0.0.1:7681"}]
TERMINAL_SERVERS=
