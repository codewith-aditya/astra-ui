{
    "name": "astragpt-backend",
    "version": "2.0.0",
    "description": "AstraGPT Backend — Tantra AI Labs",
    "main": "server.js",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "node --test test/unit.test.js test/security.test.js",
        "test:unit": "node --test test/unit.test.js",
        "test:security": "node --test test/security.test.js",
        "check:env": "node -e \"require('./config/env').report(); console.log('env OK')\"",
        "check:modules": "node scripts/verify.js"
    },
    "dependencies": {
        "@xmldom/xmldom": "0.8.11",
        "adm-zip": "0.5.16",
        "archiver": "7.0.1",
        "bcryptjs": "3.0.3",
        "cors": "2.8.6",
        "csv-parse": "6.1.0",
        "docx": "9.6.1",
        "dotenv": "16.6.1",
        "express": "4.22.1",
        "jsonwebtoken": "9.0.3",
        "mammoth": "1.11.0",
        "mongoose": "8.23.0",
        "multer": "2.1.1",
        "nodemailer": "9.0.5",
        "openai": "4.104.0",
        "otplib": "13.4.0",
        "pdf-parse": "2.4.5",
        "pdfkit": "0.17.2",
        "qrcode": "1.5.4",
        "socket.io": "4.8.3",
        "uuid": "10.0.0"
    },
    "optionalDependencies": {
        "@supabase/supabase-js": "2.58.0",
        "@upstash/redis": "1.34.3"
    },
    "devDependencies": {
        "mongodb-memory-server": "10.1.4",
        "nodemon": "3.1.14",
        "supertest": "7.0.0"
    }
}
